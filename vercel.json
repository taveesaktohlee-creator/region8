{
  "rewrites": [
    {
      "source": "/drive-upload-proxy",
      "destination": "/api/drive-upload"
    },
    {
      "source": "/training-evaluation-proxy",
      "destination": "/api/training-evaluation"
    },
    {
      "source": "/api/activity-calendar/:path*",
      "destination": "/api/activity-calendar?path=:path*"
    },
    {
      "source": "/api/notifications/:path*",
      "destination": "/api/notifications?path=:path*"
    },
    {
      "source": "/api/admin/setup-meeting-report-tables",
      "destination": "/api/meeting-reports?path=setup"
    },
    {
      "source": "/api/admin/meeting-reports/:path*",
      "destination": "/api/meeting-reports?path=admin/:path*"
    },
    {
      "source": "/api/admin/meeting-reports",
      "destination": "/api/meeting-reports?path=admin"
    },
    {
      "source": "/api/meeting-reports/:path*",
      "destination": "/api/meeting-reports?path=:path*"
    },
    {
      "source": "/api/admin/setup-activity-calendar-tables",
      "destination": "/api/activity-calendar?path=setup"
    },
    {
      "source": "/api/admin/training/courses/:id/quiz-access",
      "destination": "/api/training-evaluation?mode=quiz-access&id=:id"
    },
    {
      "source": "/api/admin/training/courses/:id",
      "destination": "/api/training-courses?mode=admin-detail&id=:id"
    },
    {
      "source": "/api/admin/training/courses",
      "destination": "/api/training-courses?mode=admin"
    },
    {
      "source": "/api/training/users/:userId/history",
      "destination": "/api/training-courses?mode=history&userId=:userId"
    },
    {
      "source": "/api/training/courses/:id",
      "destination": "/api/training-courses?mode=detail&id=:id"
    },
    {
      "source": "/api/training/courses",
      "destination": "/api/training-courses?mode=public"
    },
    {
      "source": "/api/users/forgot-password/check-email",
      "destination": "/api/forgot-password-check-email"
    },
    {
      "source": "/api/users/forgot-password/send-link",
      "destination": "/api/forgot-password-send-link"
    },
    {
      "source": "/api/users/reset-password",
      "destination": "/api/reset-password"
    },
    {
      "source": "/api/line/auth-url",
      "destination": "/api/line-auth-url"
    },
    {
      "source": "/api/line/callback",
      "destination": "/api/line-callback"
    },
    {
      "source": "/api/line/status",
      "destination": "/api/line-status"
    },
    {
      "source": "/api/admin/line-notification-settings",
      "destination": "/api/line-notifications?path=settings"
    },
    {
      "source": "/api/admin/line-notification-groups/:path*",
      "destination": "/api/line-notifications?path=groups/:path*"
    },
    {
      "source": "/api/admin/line-notification-groups",
      "destination": "/api/line-notifications?path=groups"
    },
    {
      "source": "/api/admin/line-notifications/test",
      "destination": "/api/line-notifications?path=test"
    },
    {
      "source": "/api/admin/line-webhook/status",
      "destination": "/api/line-notifications?path=webhook-status"
    },
    {
      "source": "/api/admin/line-webhook/setup",
      "destination": "/api/line-notifications?path=webhook-setup"
    },
    {
      "source": "/api/admin/line-webhook/test",
      "destination": "/api/line-notifications?path=webhook-test"
    },
    {
      "source": "/api/admin/line-webhook/capture",
      "destination": "/api/line-notifications?path=webhook-capture"
    },
    {
      "source": "/webhook/line",
      "destination": "/api/line-notifications?path=webhook"
    },
    {
      "source": "/api/:path*",
      "destination": "http://region8.duckdns.org/api/:path*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
